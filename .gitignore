celerybeat-schedule*
celerybeat.pid

# IDE / OS
.claude/
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Local scratch (never committed)
.scratch/

# Public RAG raw runs stay local; publish aggregate-only projections explicitly.
/benchmarks/public_rag/results/*
!/benchmarks/public_rag/results/published/
/tests/unit/.entity-delivery-fixture/

# Root-level review probe scratch (kept local, never committed)
/fiqa-*/
/.pytest-*/
/.pythonpath-*
/pytest-cache-files-*/

# Local frontend QA screenshots and reports may contain workspace content.
/output/playwright/
/.playwright-cli/
/.worktrees/

# One-off metadata collectors retained locally from the November research survey.
/benchmarks/_gh_meta.py
/benchmarks/_research_meta.py

# Local integration inventories, receipts, dependency copies and verification indexes.
/.review-local/
