AGENTHUB_ENVIRONMENT=local
AGENTHUB_LOG_LEVEL=INFO
AGENTHUB_DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub
AGENTHUB_REDIS_URL=redis://localhost:6379/0
AGENTHUB_QDRANT_URL=http://localhost:6333
AGENTHUB_LANGFUSE_ENABLED=false
AGENTHUB_REQUEST_ID_HEADER=X-Request-ID
AGENTHUB_READY_TIMEOUT_MS=500
AGENTHUB_AUTH_JWT_SECRET=replace-with-your-own-generated-local-secret
AGENTHUB_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AGENTHUB_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AGENTHUB_AUTH_REFRESH_COOKIE_NAME=agenthub_refresh
AGENTHUB_AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AGENTHUB_AUTH_REFRESH_COOKIE_SAMESITE=lax
AGENTHUB_AUTH_COOKIE_SECURE=false

# Where the Hugging Face weights live (bge-m3, bge-reranker-v2-m3: ~6.5 GB).
# Not read by Settings -- it has to be in the process environment before
# huggingface_hub is imported, so export it from the shell or set it as a
# user-level variable. Point it at a shared cache so a second checkout does
# not re-download the same weights into ~/.cache/huggingface.
# HF_HUB_CACHE=/path/to/shared/hf_cache

# New local model calls use benchmarks/public_rag/model-route.json:
# primary Magpie -> fallback Aliyun. Keep fallback secrets in the ignored .env.
# Workspace model profiles remain database-owned; install with scripts.model_route.
# AGENTHUB_MAGPIE_API_KEY=magpie
# AGENTHUB_RAG_API_KEY=replace-with-your-provider-key
# AGENTHUB_RAG_BASE_URL=https://your-openai-compatible-endpoint/v1
